rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Primitives
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. Validation Blueprints
    function isValidTransaction(data) {
      return data.userId == request.auth.uid
        && data.accountId is string
        && data.amount is number
        && data.amount > 0
        && data.type in ['income', 'expense']
        && (data.category is string || data.categoryId is string)
        && data.description is string && data.description.size() <= 200
        && data.date is string && data.date.size() <= 64 // ISO string
        && data.createdAt is timestamp;
    }

    function isValidAccount(data) {
      return data.userId == request.auth.uid
        && data.name is string && data.name.size() <= 100
        && data.type in ['cash', 'bank', 'credit', 'savings']
        && data.balance is number;
    }

    function isValidCategory(data) {
      return data.userId == request.auth.uid
        && data.name is string && data.name.size() <= 50;
    }

    function isValidBudget(data) {
      return data.userId == request.auth.uid
        && data.limit is number && data.limit >= 0
        && data.period in ['weekly', 'monthly', 'yearly'];
    }

    function isValidRecurring(data) {
      return data.userId == request.auth.uid
        && data.amount is number && data.amount > 0
        && data.frequency in ['daily', 'weekly', 'monthly', 'yearly']
        && data.active is bool;
    }

    function isValidProfile(data) {
      return data.dailyBudget is number
        && data.dailyBudget >= 0
        && data.currency is string && data.currency.size() <= 10
        && data.updatedAt is timestamp;
    }

    // --- Collections ---

    match /accounts/{accountId} {
      allow read: if isSignedIn() && isOwner(resource.data.userId);
      allow create: if isSignedIn() && isValidAccount(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidAccount(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn() && isOwner(resource.data.userId);
      allow create: if isSignedIn() && isValidCategory(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidCategory(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    match /budgets/{budgetId} {
      allow read: if isSignedIn() && isOwner(resource.data.userId);
      allow create: if isSignedIn() && isValidBudget(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidBudget(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    match /recurring/{recurringId} {
      allow read: if isSignedIn() && isOwner(resource.data.userId);
      allow create: if isSignedIn() && isValidRecurring(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidRecurring(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    match /transactions/{transactionId} {
      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidId(transactionId)
        && isValidTransaction(incoming())
        && incoming().createdAt == request.time
        && incoming().userId == request.auth.uid;
        
      allow update: if isSignedIn()
        && isOwner(existing().userId)
        && isValidTransaction(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['amount', 'category', 'description', 'date', 'type'])
        && incoming().updatedAt == request.time;

      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    match /profiles/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      // No list for profiles to prevent scraping
      
      allow create: if isSignedIn() 
        && isOwner(userId)
        && isValidProfile(incoming())
        && incoming().updatedAt == request.time;
        
      allow update: if isSignedIn()
        && isOwner(userId)
        && isValidProfile(incoming())
        && incoming().updatedAt == request.time;
    }
  }
}
